# ============================================================
# Edubest Platform - Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ----- Django Core -----
SECRET_KEY=your-super-secret-key-at-least-50-chars-long-change-this
DEBUG=False
ALLOWED_HOSTS=.edubest.com,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.production

# ----- Database (PostgreSQL) -----
POSTGRES_DB=edubest
POSTGRES_USER=edubest_user
POSTGRES_PASSWORD=your-strong-db-password
DATABASE_URL=postgres://edubest_user:your-strong-db-password@db:5432/edubest

# ----- Redis -----
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:your-redis-password@redis:6379/0

# ----- Email -----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@edubest.com
SUPPORT_EMAIL=support@edubest.com

# ----- AWS S3 Storage (for production) -----
USE_S3=True
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=edubest-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=cdn.edubest.com

# ----- JWT -----
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=your-jwt-signing-key-different-from-secret-key

# ----- CORS -----
CORS_ALLOWED_ORIGINS=https://edubest.com,https://*.edubest.com
CORS_ALLOW_CREDENTIALS=True

# ----- Celery -----
CELERY_BROKER_URL=redis://:your-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:your-redis-password@redis:6379/2

# ----- Sentry (Error Tracking - Production) -----
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ----- Platform Config -----
PLATFORM_DOMAIN=edubest.com
PLATFORM_NAME=Edubest
PLATFORM_ADMIN_EMAIL=admin@edubest.com

# ----- Rate Limiting -----
RATE_LIMIT_LOGIN=5/m
RATE_LIMIT_API=100/m

# ----- Encryption (for sensitive model fields) -----
FIELD_ENCRYPTION_KEY=your-32-char-encryption-key-here!!

# ----- Frontend -----
NEXT_PUBLIC_API_URL=https://api.edubest.com/api/v1
NEXT_PUBLIC_APP_URL=https://edubest.com
NEXT_PUBLIC_SENTRY_DSN=https://your-frontend-sentry-dsn

# ----- Payment Gateway (optional) -----
PAYSTACK_SECRET_KEY=sk_live_your-paystack-key
PAYSTACK_PUBLIC_KEY=pk_live_your-paystack-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
